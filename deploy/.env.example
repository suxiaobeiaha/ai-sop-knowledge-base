# ============================================================
# Dify 配置参考(精简版)
# 完整版在克隆后: deploy/dify/docker/.env.example
# 本文件仅列出本地部署必须关注的关键项
# ============================================================

# 必填:安全密钥,首次启动前必须改为随机值(setup-dify.sh 会自动生成)
SECRET_KEY=

# Dify 对外端口(默认 80;被占用时改成 8080 等)
EXPOSE_NGINX_PORT=80

# Ollama 接入不在这里配置,而是在 Dify 控制台:
#   设置 → 模型供应商 → Ollama
#   Base URL: http://host.docker.internal:28434
# 前提:本机 Ollama 设置了环境变量 OLLAMA_HOST=0.0.0.0:28434
# (11434 可能被 Windows 端口排除区间占用,见 docs/03-部署方案-本地.md)
